<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFrameworks>net462;netstandard2.0;net8.0</TargetFrameworks>
		<LangVersion>latest</LangVersion>
		<Company>Evicertia S.L.</Company>
		<RootNamespace>NLog.FastNetworkTarget</RootNamespace>
		<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
		<Authors>Evicertia</Authors>
		<Copyright>Copyright Evicertia, S.L. 2010-2021</Copyright>
		<PackageProjectUrl>https://github.com/evicertia/NLog.FastNetworkTarget</PackageProjectUrl>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<Description>A high-performance, low-CPU network target for NLog supporting high-volume TCP workloads with batching, slab coalescing, and lock-free concurrency.</Description>
		<AssemblyVersion>2.0.0.0</AssemblyVersion>
		<FileVersion>2.0.0.0</FileVersion>
		<Version>2.0.0</Version>
	</PropertyGroup>
	<ItemGroup>
	  <PackageReference Include="NLog" Version="4.7.11" />
	  <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="All" />
	</ItemGroup>
</Project>